{
  "name": "coffee-universe",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/check-budgets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:render": "node scripts/render-assets.mjs",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run build",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "bun run validate && bun run deploy:check && wrangler deploy"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "overrides": {
    "undici": "7.29.1",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3",
    "wrangler": "4.139.0"
  }
}
