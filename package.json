{
  "name": "coffee-universe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/check-budgets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:render": "node scripts/render-assets.mjs",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run build",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "bun run validate && bun run deploy:check && wrangler deploy"
  },
  "dependencies": {
    "@react-three/fiber": "^9.7.0",
    "lucide-react": "^1.44.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "~0.182.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "~0.182.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
